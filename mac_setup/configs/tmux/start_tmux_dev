#!/usr/bin/env zsh
# =============================================================================
# start_tmux_dev - Dev session launcher
# =============================================================================
# Creates a "Dev" tmux session with an apps tab and auto-opens meldr worktrees.
# Usage: ~/start_tmux_dev (aliased as 't' in zshrc)

SESSION="Dev"
LOG_FILE="$HOME/.cache/meldr-tmux-launcher.log"

# Attach if session already exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION"
fi

# Ensure the launcher log directory exists and start a fresh log for this run
mkdir -p "$(dirname "$LOG_FILE")"
: > "$LOG_FILE"

# Get terminal dimensions for percentage-based splits
COLS="$(tput cols)"
LINES="$(tput lines)"

# Create session (detached so we can configure before attaching)
tmux new-session -d -s "$SESSION" -x "$COLS" -y "$LINES"

# Export TMUX so meldr detects a tmux context when recreating worktree windows.
# Without this, `meldr worktree open` fails with NotInTmux because the script
# runs outside any tmux client.
export TMUX=$(tmux display-message -t "${SESSION}" -p '#{socket_path},#{pid},0')

# ---------------------------------------------------------------------------
# Tab 0: apps (8 panes — 2 columns x 4 rows)
# ---------------------------------------------------------------------------
tmux rename-window -t "${SESSION}:0" "apps"

# Create 7 additional panes (8 total), then tile them
for i in {1..7}; do
  tmux split-window -t "${SESSION}:apps"
done
tmux select-layout -t "${SESSION}:apps" tiled

# Select first pane
tmux select-pane -t "${SESSION}:apps.0"

# ---------------------------------------------------------------------------
# Auto-open meldr worktrees across all workspaces
# ---------------------------------------------------------------------------
if command -v meldr &>/dev/null; then
  for ws_dir in ~/workspaces/ws-*/; do
    [[ -f "$ws_dir/meldr.toml" ]] || continue

    # Reconstruct .meldr/state.json from on-disk git worktrees before listing.
    # Makes the launcher self-healing on machines that were bootstrapped
    # manually or where state.json was never synced across.
    echo "=== $ws_dir: scan ===" >>"$LOG_FILE"
    (cd "$ws_dir" && meldr worktree scan >>"$LOG_FILE" 2>&1) || true

    # Get list of worktree branches. Drop the "No active worktrees." sentinel
    # so an empty workspace doesn't feed a bogus branch to `worktree open`.
    branches=("${(@f)$(cd "$ws_dir" && meldr worktree list 2>>"$LOG_FILE" \
      | grep -v '^No active worktrees\.$' \
      | sed 's/ *(tmux:.*//' \
      | tr -d ' ')}")

    for branch in "${branches[@]}"; do
      [[ -z "$branch" ]] && continue
      # Open tmux tabs for this worktree (meldr handles the layout)
      (cd "$ws_dir" && meldr worktree open "$branch" >>"$LOG_FILE" 2>&1) &
    done
  done
  wait
fi

# Start recon after all worktree tabs are created so it doesn't race with
# meldr window creation. Loop restarts after each session switch.
tmux send-keys -t "${SESSION}:apps.0" "while true; do recon view; done" Enter

# Select first window and attach
tmux select-window -t "${SESSION}:0"
exec tmux attach-session -t "$SESSION"
